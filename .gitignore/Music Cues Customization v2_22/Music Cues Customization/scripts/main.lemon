global u8 MCC_AIZ1Knux_music
global u8 MCC_AIZ1Fire_music
global u8 MCC_HCZ1boss_music
global u8 MCC_MGZ2Knux_music
global u8 MCC_CNZ2Dark_music
global u8 MCC_LBZ2cutscene_music
global u8 MCC_LBZ2cutscene_postmusic
global u8 MCC_SOZ1boss_music
global u8 MCC_LRZ2boss_music
global u8 MCC_HPZ_music
global u8 MCC_HPZShrine_music
global u8 MCC_KnucklesHPZ_ContinueBossMusic
global u8 MCC_BlueSphereResults_music
global u8 MCC_ResumeAct2_music
global u8 MCC_FBZLaserTrap_music
global u8 MCC_SonicOutro_music
global u8 MCC_KnucklesOutro_music
global u8 MCC_SonicCredits_music
global u8 MCC_KnucklesCredits_music
global u8 MCC_SSZThrowback_BossMusic
global u8 MCC_Continue_music
global u8 MCC_CompResults_music
global u8 MCC_NoWay_music
global u8 MCC_Prev_Music

function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
	// Flying Battery 2 Laser Trap boss overrides
	if (global.zone_act == 0x0401 && (MCC_FBZLaserTrap_music > 0) && camera.position.x.u16 <= 0x2af0)
	{
		if (sfxId == 0x19 || sfxId == 0x2e)
		{
			if (MCC_FBZLaserTrap_music == 2)
			{
				soundKey = "2e_sonic3"
			}
			else
			{
				sfxId = 0x18
			}
		}
	}
	// Replicate an old Sonic 3 Alone bug where the main boss music would play instead of the miniboss music in Hydrocity 1
	if (global.zone_act == 0x0100 && (MCC_HCZ1boss_music > 0))
	{
		if (sfxId == 0x2e)
		{
			sfxId = 0x19
		}
	}
	if (camera.position.y.u16 < 0x01D1 && camera.position.x.u16 > 0x3C77 && camera.position.x.u16 < 0x3E79 && global.zone_act == 0x0201 && MCC_MGZ2Knux_music > 0)
	{
		if (sfxId == 0x19)
		{
			if (MCC_MGZ2Knux_music == 1)
			{
				soundKey = "18"
			}
			else
			{
				soundKey = "2e_sonic3"
			}
		}
	}
	if ((camera.position.y.u16 > 0x0500 && camera.position.x.u16 > 0x4300 && global.zone_act == 0x0601 && MCC_LBZ2cutscene_music == 1 && Game.getSetting(SETTING_LBZ_BIGARMS)))
	{
		if (sfxId == 0x29)
		{
			sfxId = 0x30
		}
	}
	if (global.zone_act == 0x0001)
	{
		if (MCC_AIZ1Fire_music != 0)
		{
			if (sfxId == 0x01)
			{
				sfxId = 0x02
			}
		}
	}
	// HPZ Music
	if (global.zone_act == 0x01601 && MCC_HPZ_music > 0)
	{
		if (sfxId == 0x14)
		{
			if (MCC_HPZ_music == 2)
			{
				sfxId = 0x17
			}
			else
			{
				sfxId = 0x15
			}
		}
	}
	if (global.zone_act == 0x01701 && MCC_HPZShrine_music > 0)
	{
		if (sfxId == 0x14)
		{
			if (MCC_HPZShrine_music == 2)
			{
				sfxId = 0x17
			}
			else
			{
				sfxId = 0x15
			}
		}
	}
	// Blue Sphere Difficulty Screen
	if (global.game_mode == 0x2c && MCC_BlueSphereResults_music > 0)
	{
		if (sfxId == 0x2c)
		{
			if (MCC_BlueSphereResults_music == 1)
			{
				soundKey = "2c_sonic3"
			}
			if (MCC_BlueSphereResults_music == 2)
			{
				soundKey = "2e_proto"
			}
			if (MCC_BlueSphereResults_music == 3)
			{
				sfxId = 0x1e
			}
			if (MCC_BlueSphereResults_music == 4)
			{
				soundKey = "supertheme_sonic2"
			}
		}
	}
	if (global.zone_act == 0x0a00 && (camera.position.x.u16 < 0x0400 || camera.position.x.u16 < 0x1800) && MCC_SSZThrowback_BossMusic != 0)
	{
		if (soundKey == 0x19)
		{
			if (MCC_SSZThrowback_BossMusic == 2)
			{
				soundKey = "2e_sonic3"
			}
			else
			{
				sfxId = 0x18
			}
		}
	}
	if (MCC_Continue_music > 0 && global.game_mode == 0x14)
	{
		if (soundKey == 0x28)
		{
			if ((MCC_Continue_music == 2) || (MCC_Continue_music == 3 && !isSonicAndKnucklesZone()))
			{
				soundKey = "28_sonic3"
			}
			else
			{
				sfxId = 0x28
			}
		}
	}
	if (MCC_CompResults_music > 0 && ((global.game_mode >= 0x38 && global.game_mode <= 0x44) || global.game_mode == 0x50))
	{
		if (soundKey == 0x28)
		{
			if (MCC_CompResults_music == 2)
			{
				soundKey = "28_sonic3"
			}
			else if (MCC_CompResults_music == 3)
			{
				soundKey = 0x29
			}
			else if (MCC_CompResults_music == 4)
			{
				soundKey = "2e_proto"
			}
			else
			{
				soundKey = "28"
			}
		}
	}
	if (MCC_NoWay_music > 0 && global.game_mode == 0x2c)
	{
		if (soundKey == 0x28)
		{
			if (MCC_NoWay_music == 2)
			{
				soundKey = "28_sonic3"
			}
			else
			{
				soundKey = "28"
			}
		}
	}
	// Are we in Carnival Night 2? Is the prototype music option for Act 2 on? Are the lights out? 
	if (global.zone_act == 0x0301 && (u8[0xfffffaa3] == 0xff) && MCC_CNZ2Dark_music > 0)
	{
		if (soundKey == 0x08)
		{
			// Choose between act 1 and 2 themes
			if (MCC_CNZ2Dark_music == 1)
			{
				return "07"
			}
			else
			{
				return "08"
			}
		}
	}
	if sfxId == MUSIC_LEVELCLEAR && MCC_LBZ2cutscene_music > 0 && camera.position.y.u16 > 0x0500 && camera.position.x.u16 > 0x4300 && global.zone_act == 0x0601 && Game.getSetting(SETTING_LBZ_BIGARMS)
	{
		return soundKey = (MCC_LBZ2cutscene_music == 2) ? "28_sonic3" : "28"
	}
	if sfxId == MUSIC_KNUCKLES && MCC_AIZ1Knux_music && (Game.getSetting(SETTING_AIZ_INTRO_KNUCKLES) != 0 && global.zone_act == 0x0000 && isMainCharacter(CHARACTER_KNUCKLES) && checkpoint.number == 0 && !Game.isTimeAttack())
	{
		if (MCC_AIZ1Knux_music == 2)
			soundKey = "1f_proto"
		else if (MCC_AIZ1Knux_music == 3)
			sfxId = 0x01
		else
			soundKey = "1f_sonic3"
	}
	if (global.zone_act == 0x0d01 && MCC_SonicOutro_music < 3)
	{
		if (soundKey == 0x26)
		{
			if (MCC_SonicOutro_music == 0)
			{
				sfxId = 0x15
			}
			else if (MCC_SonicOutro_music == 2)
			{
				soundKey = "26_proto"
			}
			else
			{
				soundKey = "26"
			}
		}
	}
	if (global.zone_act == 0x0a01 && MCC_KnucklesOutro_music < 3)
	{
		if (soundKey == 0x26)
		{
			if (MCC_KnucklesOutro_music == 0)
			{
				sfxId = 0x15
			}
			else if (MCC_KnucklesOutro_music == 2)
			{
				soundKey = "26_proto"
			}
			else
			{
				soundKey = "26"
			}
		}
	}
	if sfxId == MUSIC_CREDITSMEDLEY
	{
		if (global.zone_act == 0x0d01)
		{
			if (MCC_SonicCredits_music == 0)
				sfxId = 0x15

			else if (MCC_SonicCredits_music == 1)
				soundKey = "26"

			else if (MCC_SonicCredits_music == 2)
				soundKey = "26_proto"
			else if (MCC_SonicCredits_music == 3)
				return Standalone.getModdedSoundKey(0x26, 0x26, SoundRegType.TYPE_MUSIC)
		}
		if (global.zone_act == 0x0a01)
		{
			if (MCC_KnucklesCredits_music == 0)
			{
				sfxId = 0x15
			}
			else if (MCC_KnucklesCredits_music == 1)
			{
				soundKey = "26"
			}
			else if (MCC_KnucklesCredits_music == 2)
			{
				soundKey = "26_proto"
			}
			else if (MCC_KnucklesCredits_music == 3)
				return Standalone.getModdedSoundKey(0x26, 0x26, SoundRegType.TYPE_MUSIC)
		}
	}
	
    return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}
// Prevent Final Boss Music fadeout and others
function void Standalone.playAudio(u8 sfxId)
{
	if ((((global.zone_act == 0x1700 && level.skip_titlecard == 0xff) || (level.wait_for_results == 0xff && camera.position.y.u16 > 0x0500 && camera.position.x.u16 > 0x4300 && global.zone_act == 0x0601 && MCC_LBZ2cutscene_music < 2 && Game.getSetting(SETTING_LBZ_BIGARMS)))))
	{
		MSA.skipSound = MUSIC_CTRL_FADEOUT
	}
	base.Standalone.playAudio(sfxId)
}

function u64 MSA.setupSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
	if MCC_Prev_Music > 0 && MCC_Prev_Music != sfxId
	{
		soundKey = Standalone.getModdedSoundKey(MCC_Prev_Music, MCC_Prev_Music, soundRegType)
		MCC_Prev_Music = 0
	}
	return base.MSA.setupSoundKey(soundKey, sfxId, soundRegType)
}

// Restart music when lights turn on.
//# address-hook(0x065d8c) end(0x065dd0)
function void fn065d8c()
{
	// If invincibility or super music is playing, don't override it
	if (u8[0xfffffaa3] == 0 && ((Audio.isPlayingAudio(0x08) || (Audio.isPlayingAudio(0x07)))) && MCC_CNZ2Dark_music)
		playSound(0x08)
	base.fn065d8c()
}

// Allow Knuckles' boss music to continue playing throughout Emerald theft cutscene (1)
//# address-hook(0x064310) end(0x06434e)
function void fn064310()
{
	if (MCC_KnucklesHPZ_ContinueBossMusic == 1 && global.zone_act == 0x1601)
		if allocDynamicObjectStd()
			MSA.skipSound = 0x085b30
	base.fn064310()
}
// (2)
//# address-hook(0x064ca6) end(0x064d14)
function void fn064ca6()
{
	if (MCC_KnucklesHPZ_ContinueBossMusic == 1 && global.zone_act == 0x1601)
		if allocDynamicObjectStd()
			MSA.skipSound = 0x085b30
	base.fn064ca6()
}

// Make the Sandopolis 1 boss fade back to level music after defeat
//# address-hook(0x076e0a) end(0x076e48)
function void fn076e0a()
{
#if STANDALONE
	// spawn the object that will Fade out And start playing SOZ1 music
	if MCC_SOZ1boss_music == 1 && !boss.remaining_hits
		if allocDynamicObjectStd()
			objA1.update_address = 0x085b0a
#endif
	base.fn076e0a()
}
//# address-hook(0x0729de) end(0x072a4e)
function void fn0729de()
{
	base.fn0729de()
#if STANDALONE
	if (camera.position.y.u16 >= 0x0500)
#else
	if (!isMainCharacter(CHARACTER_KNUCKLES))
#endif
		if (allocDynamicObjectStd())
			if MCC_LRZ2boss_music == 1
				MSA.skipSound = 0x085b30

}

// Prevent Act results from playing after Big Arm (Sonic)
//# address-hook(0x02dc36) end(0x02dd38)
function void LevelResults.UpdateBonusCounting()
{
	if (MCC_LBZ2cutscene_music > 0 && camera.position.y.u16 > 0x0500 && camera.position.x.u16 > 0x4300 && global.zone_act == 0x0601 && Game.getSetting(SETTING_LBZ_BIGARMS))
	{	
		// Play ending jingle if selected
		MSA.skipSound = "!sfx"
		if (MCC_LBZ2cutscene_music == 2)
		{
			Audio.playAudio(Standalone.getModdedSoundKey("32_sonic3", 0x32, SoundRegType.TYPE_JINGLE), AudioContext.CONTEXT_MUSIC)
		}
		if (MCC_LBZ2cutscene_music == 3)
		{
			Audio.playAudio(Standalone.getModdedSoundKey("32", 0x32, SoundRegType.TYPE_JINGLE), AudioContext.CONTEXT_MUSIC)
		}
		MCC_LBZ2cutscene_music = 0
	}
	base.LevelResults.UpdateBonusCounting()
}

//# address-hook(0x02dae6) end(0x02dbc8)
function void fn02dae6()
{
	base.fn02dae6()
	if ((camera.position.y.u16 > 0x0500 && camera.position.x.u16 > 0x4300 && global.zone_act == 0x0601 && MCC_LBZ2cutscene_music > 0 && Game.getSetting(SETTING_LBZ_BIGARMS)))	
		if (MCC_LBZ2cutscene_music == 1)
			objA0.countdown_value = 168 // Decrease wait time due to lack of jingle
}

// Prevent LBZ2 music from starting up again after Act results
//# address-hook(0x072b96) end(0x072bb6)
function void fn072b96()
{
	base.fn072b96()
	if ((camera.position.y.u16 > 0x0500 && camera.position.x.u16 > 0x4300 && global.zone_act == 0x0601 && (MCC_LBZ2cutscene_postmusic > 0 || MCC_LBZ2cutscene_music == 1) && Game.getSetting(SETTING_LBZ_BIGARMS)) && level.results_done)
	{
		if (MCC_LBZ2cutscene_music != 1)
		{
			if (MCC_LBZ2cutscene_postmusic == 2)
			{
				// Play S3 credits music if selected
				Audio.playAudio(Standalone.getModdedSoundKey("26", 0x26, SoundRegType.TYPE_MUSIC), AudioContext.CONTEXT_MUSIC)
			}
			else if (MCC_LBZ2cutscene_postmusic == 3)
			{
				// Play S3 proto credits music if selected
				Audio.playAudio(Standalone.getModdedSoundKey("26_proto", 0x26, SoundRegType.TYPE_MUSIC), AudioContext.CONTEXT_MUSIC)
			}
			else if (MCC_LBZ2cutscene_postmusic == 4)
			{
				// Restart Final Boss Music
				playMusic(0x30)
			}	
		}
	}
}

// Post Zone 
//# address-hook(0x085b60) end(0x085b84)
function void PlayMusicAfterLevelResults()
{
	if ((((MCC_ResumeAct2_music == 1 && global.zone_act != 0x1600) || (MCC_ResumeAct2_music == 2 && ((!isSonicAndKnucklesZone())))) && (level.results_done && level.capsule_opened)) || (level.results_done && MCC_ResumeAct2_music == 1 && (global.zone_act == 0x0601 && !(Game.getSetting(SETTING_LBZ_BIGARMS)))))
		return
	base.PlayMusicAfterLevelResults()
}

//# address-hook(0x0799e0) end(0x079a50)
function void fn0799e0()
{
	if (MCC_ResumeAct2_music == 1)
	{
		MCC_Prev_Music = u8[A1 + 0x2c]	
	}
	base.fn0799e0()
}

