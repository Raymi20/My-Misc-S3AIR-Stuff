constant array<string> ALT_TITLE_MUSIC = {"25_sonic3", "25_sonic3mb", "25_sonic3rsg", "25", "25_old", "25_oldedit"}
constant array<string> ALT_SAVESELECT = {"2f_og", "2f_arr"}
constant array<string> ALT_INVIN_MUSIC = {"2c_sonic3", "2c_sonic3aa", "2c", "2c_old"}
constant array<string> ALT_DROWNING_THEME = {"31_sk", "31_sonic2", "31"}
constant array<string> ALT_MINIB_MUSIC = {"2e_sonic3", "2e_sonic3isk", "18", "18_isk"}
constant array<string> ALT_BOSS_MUSIC = {"19_sonic3", "19_arr", "19", "19_part2", "19_isk"}
constant array<string> ALT_SUPER_THEME = {"2c_sonic3", "2c_sonic3re", "2c", "2c_old", "supertheme_isk", "supertheme_sonic2", "hypertheme_isk", "2e_proto"}
constant array<string> ALT_EXTRALIFE_JINGLE = {"2a_sonic3", "2a", "2a_earlier", "2a_old"}
constant array<string> ALT_KNUCKLES_MUSIC = {"1f_proto", "1f_sonic3", "1f", "f9", "f4"}
constant array<string> ALT_AIZ1_MUSIC = {"01", "01_arr", "01_isk"}
constant array<string> ALT_AIZ2_MUSIC = {"02", "02_arr", "02_isk"}
constant array<string> ALT_HCZ1_MUSIC = {"03", "03_arr", "03_isk"}
constant array<string> ALT_HCZ2_MUSIC = {"04", "04_arr", "04_arredit"}
constant array<string> ALT_MGZ1_MUSIC = {"05", "05_laz", "05_arr", "05_isk"}
constant array<string> ALT_MGZ2_MUSIC = {"06", "06_arr", "06_isk"}
constant array<string> ALT_CNZ1_MUSIC = {"07_proto", "07_old", "07", "07_isk"}
constant array<string> ALT_CNZ2_MUSIC = {"08_proto", "08", "07_proto", "08_isk"}
constant array<string> ALT_ICZ1_MUSIC = {"0b_proto", "0b", "0b_alt", "0b_isk"}
constant array<string> ALT_ICZ2_MUSIC = {"0c_proto", "0c", "0b_isk"}
constant array<string> ALT_LBZ1_MUSIC = {"0d_proto", "0d", "0d_edit"}
constant array<string> ALT_LBZ2_MUSIC = {"0e_proto", "0e", "0e_arr"}
constant array<string> ALT_FINALBOSS_MUSIC = {"30", "30_old"}
constant array<string> ALT_MHZ1_MUSIC = {"0f", "0f_s&k", "0f_alt", "0f_isk"}
constant array<string> ALT_MHZ2_MUSIC = {"10", "10_alt", "10_isk"}
constant array<string> ALT_SOZ1_MUSIC = {"11", "11_isk"}
constant array<string> ALT_LRZ1_MUSIC = {"13", "13_isk"}
constant array<string> ALT_LRZ2_MUSIC = {"14", "14_isk"}
constant array<string> ALT_KNUX_FIGHT_MUSIC = {"1f_proto", "1f_sonic3", "1f", "2e_sonic3", "2e_sonic3isk", "18", "18_isk"}
constant array<string> ALT_SSZ_MUSIC = {"15", "15_isk"}
constant array<string> ALT_S1BOSS_MUSIC = {"sonic1_boss", "sonic1_bossevst", "sonic1_bossalt"}
constant array<string> ALT_DEZ1_MUSIC = {"16", "16_s&k", "16_z"}
constant array<string> ALT_DEZ2_MUSIC = {"17", "17_s&k", "17_z"}
constant array<string> ALT_DDZ_MUSIC = {"1a", "1a_og", "1a_isk"}
constant array<string> ALT_OUTRO_MUSIC = {"26_proto", "26"}
constant array<string> ALT_GLOWBALL_MUSIC = {"1b", "1b_ttr"}
constant array<string> ALT_SLOT_MUSIC = {"1d", "1d_isk"}
constant array<string> ALT_GUMBALL_MUSIC = {"1e", "1e_isk"}
constant array<string> ALT_CONTINUE_MUSIC = {"28", "28_edit", "28_sonic3"}
#define S3K_AST = 1
#if STANDALONE
function u8 BossHPZKnuckles.chooseMusicTrack()
{
	if option.altKnuxFightTrack == 1
		return 0xf6
	else if option.altKnuxFightTrack == 2
		return 0xf7
	return MUSIC_KNUCKLES
}
#endif
function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
	if s3ka.enableDiscordRPC
		Game.setDiscordDetails(stringformat("with the %s", s3ka.modname))
	if soundKey == "2e_sonic3"
		return ALT_MINIB_MUSIC[option.pbzAltS3MinibossTrack]
	if soundKey == "18"
		return ALT_MINIB_MUSIC[option.pbzAltSKMinibossTrack]
	u16 ecf.extchar
	#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
		ecf.extchar = global_ExChar_num[0]
	#endif
	bool isExtraChar = u8[0xffffE654] || u8[0xfffff0] || u8[0xfffff2] || u8[0xfffff4] || ecf.extchar || global.characters > 3 // Doing this for my own sanity
	if System.isDevModeActive()
	{
		debugLog(stringformat("(ESU) u8[0xffffE654]=%x, (ECF) global_ExChar_num[0]=%x, (MISC) global.characters=%x", u8[0xffffE654], ecf.extchar, global.characters))
		debugLog(stringformat("(SCF) u8[0xfffff0]=%01x, u8[0xfffff2]=%x, u8[0xfffff4]=%x", u8[0xfffff0], u8[0xfffff2], u8[0xfffff4]))
		debugLog(stringformat("isExtraChar=%x", isExtraChar))
	}
	u64 altMSmk2Music = (global.zone_act == 0x0a01 && option.altMecha1Track == 1) || (global.zone_act != 0x0a01 && option.altMechaTrack == 1) ? "fb_s4ep2" : 0xfb
	if (sfxId == MUSIC_TITLESCREEN)
		return ALT_TITLE_MUSIC[option.altTitleTrack]
	if (sfxId == MUSIC_DATASELECT)
		return ALT_SAVESELECT[option.altSaveSlctTrack]
	if (sfxId == MUSIC_INVINCIBLE)
	{
		if (option.altInvinTrack > 3)
			return soundKey = (isSonicAndKnucklesZone()) ? ALT_INVIN_MUSIC[option.pbzAltSKInvinTrack] : ALT_INVIN_MUSIC[option.pbzAltS3InvinTrack]
		return ALT_INVIN_MUSIC[option.altInvinTrack]
	}
	if (sfxId == MUSIC_SUPER)
	{
		if (option.altHyperTrack < 7 && (super.active == 0xff || super.active.tails == 0xff))
			return ALT_SUPER_THEME[option.altHyperTrack]
		if (option.altSuperTrack < 7)
			return ALT_SUPER_THEME[option.altSuperTrack]
	}
	if (sfxId == MUSIC_DROWNING)
		return ALT_DROWNING_THEME[option.altDrownTrack]
	if (sfxId == MUSIC_LEVELCLEAR && global.game_mode != 0x04 && global.game_mode != 0x0c && global.game_mode != 0x48)
		return "29_long"
	if sfxId == MUSIC_KNUCKLES && !Mods.isModActive("Music Cues Customization") && (!Game.getSetting(SETTING_AIZ_INTRO_KNUCKLES) && global.zone_act != 0x0000 && !isMainCharacter(CHARACTER_KNUCKLES) && checkpoint.number != 0 && Game.isTimeAttack())
		return soundKey = (option.altKnuxTrack >= 3 && isSonicAndKnucklesZone()) ? 0x1f : ALT_KNUCKLES_MUSIC[option.altKnuxTrack]
	if (sfxId == MUSIC_MINIBOSS || sfxId == MUSIC_MINIBOSS_2)
	{
        if (option.altMinibossTrack < 4)
			return ALT_MINIB_MUSIC[option.altMinibossTrack]
		else if (isSonicAndKnucklesZone())
			return ALT_MINIB_MUSIC[option.pbzAltSKMinibossTrack]
		else
			return ALT_MINIB_MUSIC[option.pbzAltS3MinibossTrack]
	}
	if (sfxId == MUSIC_MAINBOSS)
	{
		if (global.zone_act == 0x1600)
			return "14_boss"
		else if (global.zone_act == 0x0a00 && option.altMechaTrack < 2)
			return altMSmk2Music
		else if (option.altBossTrack < 5)
			return ALT_BOSS_MUSIC[option.altBossTrack]
		else if (isSonicAndKnucklesZone())
			return ALT_BOSS_MUSIC[option.pbzAltSKBossTrack]
		else
			return ALT_BOSS_MUSIC[option.pbzAltS3BossTrack]
	}
	if (sfxId == MUSIC_AIZ1)
        return ALT_AIZ1_MUSIC[option.altAIZ1Track]
    if (sfxId == MUSIC_AIZ2)
        return ALT_AIZ2_MUSIC[option.altAIZ2Track]
    if (sfxId == MUSIC_HCZ1)
        return ALT_HCZ1_MUSIC[option.altHCZ1Track]
    if (sfxId == MUSIC_HCZ2)
        return ALT_HCZ2_MUSIC[option.altHCZ2Track]
	if (sfxId == MUSIC_MGZ1)
        return ALT_MGZ1_MUSIC[option.altMGZ1Track]
	if (sfxId == MUSIC_MGZ2)
        return soundKey = (isMainCharacter(CHARACTER_KNUCKLES) && !isExtraChar && enable.altMGZ2KnuxTrack) ? "06_knux" : ALT_MGZ2_MUSIC[option.altMGZ2Track]
	if (sfxId == MUSIC_CNZ1)
		return ALT_CNZ1_MUSIC[option.altCNZ1Track]
    if (sfxId == MUSIC_CNZ2)
		return ALT_CNZ2_MUSIC[option.altCNZ2Track]
    if (sfxId == MUSIC_ICZ1)
		return ALT_ICZ1_MUSIC[option.altICZ1Track]
    if (sfxId == MUSIC_ICZ2)
		return ALT_ICZ2_MUSIC[option.altICZ2Track]
    if (sfxId == MUSIC_LBZ1)
		return ALT_LBZ1_MUSIC[option.altLBZ1Track]
    if (sfxId == MUSIC_LBZ2)
		return ALT_LBZ2_MUSIC[option.altLBZ2Track]
	if (sfxId == MUSIC_BIGARMS)
	{
		if (!isSonicAndKnucklesZone())
			return ALT_FINALBOSS_MUSIC[option.altS3FinBossTrack]
		else if (global.zone_act == 0x0a01)
			return soundKey = option.altMecha1Track < 2 ? altMSmk2Music : ALT_FINALBOSS_MUSIC[option.altMecha1Track-2]
		else
			return ALT_FINALBOSS_MUSIC[option.altSKFinBossTrack]
	}
	if (sfxId == MUSIC_MHZ1)
		return ALT_MHZ1_MUSIC[option.altMHZ1Track]
	if (sfxId == MUSIC_MHZ2)
		return ALT_MHZ2_MUSIC[option.altMHZ2Track]
	if (sfxId == MUSIC_SOZ1)
		return ALT_SOZ1_MUSIC[option.altSOZ1Track]
	if (sfxId == MUSIC_LRZ1)
		return ALT_LRZ1_MUSIC[option.altLRZ1Track]
	if (sfxId == MUSIC_LRZ2)
	{
		if (global.zone_act == 0x1600 && !option.altHPZTrack)
			return "lrz_old"
		else if System.getGlobalVariableValueByName("hidden_palace_music") < 2 && (global.zone_act != 0x1601 || global.zone_act != 0x1701)
		{
			if ((isMainCharacter(CHARACTER_KNUCKLES) && !isExtraChar) && enable.knuxHPZinLRZ2)||(global.zone_act == 0x1601 || global.zone_act == 0x1701)||(Mods.isModActive("seamless-hpz-lrz-s3air-main") && global.zone_act == 0x1600 && !System.getGlobalVariableValueByName("trans.audio") && level.results_done)
				return soundKey = option.altHPZTrack ? "fa_isk" : 0xfa
			else
				return ALT_LRZ2_MUSIC[option.altLRZ2Track]
		}
	}
	if sfxId == 0xf6 || sfxId == 0xf7
	{
		option.altEmeraldStealTrack *= global.zone_act == 0x1601 && level.boss_encounter && (char.control_flags & control_flag.DISABLE_INTERACTION || !control.player1)
		if option.altEmeraldStealTrack == 1
			return Standalone.getModdedSoundKey(MUSIC_MINIBOSS, MUSIC_MINIBOSS, soundRegType)
		if sfxId == 0xf6 || option.altEmeraldStealTrack == 2
			return ALT_MINIB_MUSIC[option.pbzAltS3MinibossTrack]
		if sfxId == 0xf7 || option.altEmeraldStealTrack == 3
			return ALT_MINIB_MUSIC[option.pbzAltSKMinibossTrack]
	}
	if (sfxId == MUSIC_SSZ)
		return ALT_SSZ_MUSIC[option.altSSZTrack]
	if (sfxId == MUSIC_BOSS_S1)
		return ALT_S1BOSS_MUSIC[option.altSonic1BossTrack]
	if (sfxId == MUSIC_DEZ1)
		return ALT_DEZ1_MUSIC[option.altDEZ1Track]
	if (sfxId == MUSIC_DEZ2)
		return ALT_DEZ2_MUSIC[option.altDEZ2Track]
	if (sfxId == MUSIC_DDZ)
		return soundKey = (global.zone_act == 0x0a01 && option.altMecha2Track) ? ALT_DDZ_MUSIC[option.altMecha2Track] : ALT_DDZ_MUSIC[option.altDDZTrack]
	if (global.zone == 0x0d || global.zone_act == 0x0a01) && enable.onlyMedleyifBE
	{
		if sfxId == MUSIC_ENDING
			return soundKey = (global.super_emeralds < 7) ? "26_proto" : MUSIC_CREDITSMEDLEY
		if sfxId == MUSIC_CREDITSMEDLEY && global.super_emeralds < 7
			return "26"
	}
	if (sfxId == MUSIC_GLOWINGSPHERES)
		return ALT_GLOWBALL_MUSIC[option.altGlowballTrack]
	if (sfxId == MUSIC_SLOTMACHINE)
		return ALT_SLOT_MUSIC[option.altSlotTrack]
	if sfxId == MUSIC_GUMBALLMACHINE
		return ALT_GUMBALL_MUSIC[option.altGumballTrack]
	if sfxId == MUSIC_CONTINUE && (!Mods.isModActive("SoundAdditionsPlus.zip") || !Mods.isModActive("SoundAdditionsPlus"))&&((!System.getGlobalVariableValueByName("competition_results_music")&&(global.game_mode != 0x44 || global.game_mode != 0x50)) || global.game_mode != 0x2c)
	{
		if option.altContinueTrack > 2
			return soundKey = (isSonicAndKnucklesZone()) ? ALT_CONTINUE_MUSIC[option.pbzAltSKContinueTrack] : "28_sonic3"
		return ALT_CONTINUE_MUSIC[option.altContinueTrack]
	}
	if sfxId == 0x1c
		return "1c_isk"
#if MUSIC_SCRIPTS_ADJUSTED
	if (sfxId == MUSIC_EXTRALIFE)
	{
		soundRegType = SoundRegType.TYPE_JINGLE
		if (option.alt1upTrack > 3)
			return soundKey = (isSonicAndKnucklesZone()) ? ALT_EXTRALIFE_JINGLE[option.pbzAltSK1upTrack] : ALT_EXTRALIFE_JINGLE[option.pbzAltS31upTrack]
		return ALT_EXTRALIFE_JINGLE[option.alt1upTrack]
	}
#else
	debugLog("Extra Life jingle options require Music Scripts Adjustments!")
#endif
	u64 SAP_check = base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
	if SAP_check == "chaosemerald_fix"
		SAP_check = 0x2b
	return SAP_check
}
function u8 Standalone.getModdedSoundRegType(u64 soundKey, u8 sfxId, u8 soundRegType)
{
	if sfxId == 0xfa || sfxId == 0xfb
		return SoundRegType.TYPE_MUSIC
	return base.Standalone.getModdedSoundRegType(soundKey, sfxId, soundRegType)
}
#if !MUSIC_SCRIPTS_ADJUSTED
function void MainMenuBG.Run()
{
	debugLog("Modded music on A.I.R. menu requires Music Scripts Adjustments")
	base.MainMenuBG.Run()
}
#endif
//# address-hook(0x0572ba) end(0x057342)
function void fn0572ba()
{
	System.setGlobalVariableValueByName("sky_sanctuary_climb_music", false)
	base.fn0572ba()
}
//# address-hook(0x05b514) end(0x05b564)
function void fn05b514()
{
	base.fn05b514()
#if STANDALONE
	#if CREDITS_CALC_IMPROVED
		if Audio.isPlayingAudio("dc")
			outro.scroll_speed = CreditsRoll.calculateScrollSpeed(19780)
	#else
		debugLog("Extended credits duration requires Improved Credits Calculations!")
	#endif
#endif
}