global bool Sms8Powa.disableLBZ2MiniBossTheme = 0
global bool Sms8Powa.disableCalmIcedus = 0
global bool Sms8Powa.disableAIZ1SpikeBug = 0
global bool Sms8Powa.disableLRZ3SuperMusicFix = 0
global bool Sms8Powa.disableLRZ3InvincibilityMusicFix = 0
global bool Sms8Powa.disableDEZ3InvincibilityMusicFix = 0
global bool Sms8Powa.disableSOZ2BossInvincibilityMusicFix = 0
global bool Sms8Powa.disableLaserOnSuperHurt = 0
global bool WonderPower.disableAmyClearForSTK = 0
global bool WonderPower.disableMightyRaySlotIcon = 0
global u8 WonderPower.amySlotIconType

// Extend this one if you need it
// ex. u8[0xffffE654] != yourCharNum && base.WonderPower.isAmySlotEnabled()
function bool WonderPower.isAmySlotEnabled()
{
	return WonderPower.amySlotIconType != 0
}

function bool WonderPower.isAmyGaloreActive() 
{
	return Mods.isModActive("Sonic 3 AIR: Amy Galore")
}

function u8 WonderPower.isAmyLoaded()
{
	// returns the mod type
	if(Mods.isModActive("extra-slot-project-amy"))
		return 0x01
	else if(Mods.isModActive("Extra Slot Amy"))
		return 0x01
	else if(Mods.isModActive("Extra Slot Amy (Sonic Origins)"))
		return 0x02
	else if(WonderPower.isAmyGaloreActive())
		return 0x03
	return 0x00
}

function bool WonderPower.isMightyOrRay()
{
	if(u8[0xffffE654] == 1)
		return true
	if(u8[0xffffE654] == 2)
		return true
	return false
}

function bool WonderPower.isAmy()
{
	if(u8[0xffffE654] == 3)
		return true
	if(u8[0xffffE654] == 6)
		if(WonderPower.isAmyGaloreActive())
			return true
	return false
}

function bool WonderPower.isTeamSonic()
{
	return u8[0xffffE654] == 0
}