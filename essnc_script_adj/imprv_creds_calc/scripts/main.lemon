#define CREDITS_CALC_IMPROVED = 1
global u32 credits.u32_lines
global u32 credits.line_count = 2 // Final spacing (assuming the spacing from the credits datagen starts from 1)
global bool ICC.calc_done
global u64 ICC.timerDiff
global u8 ICC.credsAddress[255] // I am NOT taking ANY chances
