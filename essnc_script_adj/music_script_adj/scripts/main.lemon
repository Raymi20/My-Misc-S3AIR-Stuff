function bool Game.isTimeAttack()
{
	if base.Game.isTimeAttack()
		Audio.stopChannel(4)
	return base.Game.isTimeAttack()
}
#if STANDALONE
function void Audio.playAudio(u64 sfxId, u8 contextId)
{
	if System.isDevModeActive()
		debugLog(stringformat("Audio.playAudio(sfxId=%s(%x), contextId=%x)",sfxId, sfxId, contextId))
	// Euka, why did you make me do this
	if sfxId == "1f" && contextId == AudioContext.CONTEXT_MUSIC && Game.getSetting(SETTING_AIZ_INTRO_KNUCKLES) != 0 && global.zone_act == 0x0000 && isMainCharacter(CHARACTER_KNUCKLES) && checkpoint.number == 0 && !Game.isTimeAttack()
		sfxId = Standalone.getModdedSoundKey(sfxId, 0x1f, 0)
	base.Audio.playAudio(sfxId, contextId)
}
#endif
function bool Outro.isSameMusic()
{
	bool snd = Standalone.getModdedSoundKey(MUSIC_ENDING, MUSIC_ENDING, 0) == Standalone.getModdedSoundKey(MUSIC_CREDITSMEDLEY, MUSIC_CREDITSMEDLEY, 0)
	debugLog(stringformat("Outro.isSameMusic(): %x", snd))
	return snd
}
// Fadeout + Resume music after countdown
//# address-hook(0x085b0a) end(0x085b2a)
function void fn085b0a()
{
	if System.isDevModeActive()
		debugLog(stringformat("fn085b0a(): MSA.skipSound=%x",MSA.skipSound))
	if MSA.skipSound == 0x85b0a
	{
		MSA.skipSound = 0
		UnloadObject()
		return
	}
	base.fn085b0a()
}
// Fadeout + Change BGM before boss
//# address-hook(0x085b30) end(0x085b3e)
function void fn085b30()
{
	if System.isDevModeActive()
		debugLog(stringformat("fn085b30(): MSA.skipSound=%x",MSA.skipSound))
	if MSA.skipSound == 0x85b30
	{
		MSA.skipSound = 0
		UnloadObject()
		return
	}
	base.fn085b30()
}
// S&T Outro init
//# address-hook(0x05b1a2) end(0x05b1e6)
function void fn05b1a2()
{
	if Outro.isSameMusic()
		MSA.skipSound = 0x85b30
	base.fn05b1a2()
}
// S&T Outro Master Emerald
